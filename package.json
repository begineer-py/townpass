{
  "name": "townpass-friendly-path",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0 --mode https",
    "build": "node scripts/validate-routing-data.mjs && vite build && node scripts/build_sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "data:sync": "python scripts/sync_data.py",
    "data:graph": "python scripts/build_graph.py",
    "data:pack": "python scripts/pack_data.py",
    "data:map-index": "node scripts/build-landmarks.mjs && node scripts/build-facility-tiles.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "leaflet": "1.9.4",
    "leaflet-rotate": "0.2.8",
    "lucide-react": "^0.468.0",
    "proj4": "^2.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  },
  "license": "AGPL-3.0-or-later"
}
